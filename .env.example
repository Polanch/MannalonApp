# No map API key is required. Maps use Leaflet and OpenStreetMap.
# Frontend: Vite loads this from .env.local. Restart Vite after changing it.
VITE_API_ORIGIN=http://localhost:8080
# Variables below are for the backend only.
# Spring Boot does not automatically load this file; set these in the backend process environment.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=deepseek-r1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_READ_TIMEOUT_SECONDS=180
CHATBOT_RAG_INGEST_ENABLED=true
CHATBOT_RAG_INGEST_ON_STARTUP=false
# Set a comma-separated list of permitted IRRI article URLs before ingestion.
# CHATBOT_RAG_APPROVED_URLS=
# Optional persistent local storage directory for uploaded library PDFs and covers (backend only).
# LIBRARY_UPLOAD_DIRECTORY=C:\mannalon-data\library
